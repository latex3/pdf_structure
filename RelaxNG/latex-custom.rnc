# LaTeX PDF 2.0 Namespace Schema extensions v1.7c

namespace pdf2 = "http://iso.org/pdf2/ssn"
namespace latexSEamse = "https://www.latex-project.org/ns/local/asmeconf"
namespace luatexko = "https://www.latex-project.org/ns/local/luatexko"
namespace latexSEamsej = "https://www.latex-project.org/ns/local/asmejour"
namespace mitthesis = "https://www.latex-project.org/ns/local/mitthesis"
namespace test = "https://www.latex-project.org/ns/local"

include "latex-namespace.rnc"


# asmeconf

#    \tagpdfsetup { role/new-tag = { Conference_information/Div       } }
#    \tagpdfsetup { role/new-tag = { Paper_number/Div                 } }
#    \tagpdfsetup { role/new-tag = { Author_affiliation/Div           } }
#    \tagpdfsetup { role/new-tag = { Authors/Div                      } }
#    \tagpdfsetup { role/new-tag = { Affiliations-group/Div           } }
#    \tagpdfsetup { role/new-tag = { Affiliation/Part                 } }
#
#    \tagpdfsetup { role/new-tag = { Nomenclature_list/Div            } }
#    \tagpdfsetup { role/new-tag = { Nomenclature_entry_heading/Span  } }
#    
#    \tagpdfsetup { role/new-tag = { Wrapper/P } } % for coffin tagging


latex.document.content |=
(Conference_information,semantic-para*,ltxtitle*,Authors*,Affiliations-group*,
footnote*,section*,(figures|tables)*)


Conference_information =element latexSEamse:Conference_information {
  showtags-attributes,
  attribute rolemaps-to {"Div"},
  attribute id {text}?,
  semantic-para*
}



Div |= element latexSEamse:Author_affiliation {
  showtags-attributes,
  attribute rolemaps-to {"Div"},
  attribute id {text}?,
  semantic-para*
  }

Affiliations-group = element latexSEamse:Affiliations-group {
  showtags-attributes,
  attribute rolemaps-to {"Div"},
  attribute id {text}?,
  semantic-para*
  }

Div|= element latexSEamse:Affiliation {
  showtags-attributes,
  attribute rolemaps-to {"Div"},
  attribute id {text}?,
  semantic-para*
  }

Authors = element latexSEamse:Authors {
  showtags-attributes,
  attribute rolemaps-to {"Div"},
  attribute id {text}?,
  attribute title {text}?,
  semantic-para*
  }


semantic-para |= element latexSEamse:Paper_number {
  showtags-attributes,
  attribute rolemaps-to {"Div"},
  attribute id {text}?,
  attribute title {text}?,
  semantic-para*
  }


Sect.content |= element latexSEamse:Nomenclature_list {
  showtags-attributes,
  attribute rolemaps-to {"Div"},
  attribute id {text}?,
  semantic-para*
  }

text-fragment |= element latexSEamse:Nomenclature_entry_heading {
  showtags-attributes,
  attribute rolemaps-to {"Span"},
  attribute id {text}?,
  (latex.inline.content)*
  }

# luatexko

Span |= element luatexko:StrikeOut {
  pdf2-attributes,
  attribute rolemaps-to {"Span"},
  (text|Span)*
  }

Div|= element luatexko:Vertical {
  pdf2-attributes,
  attribute rolemaps-to {"Div"},
  (semantic-para|P)*
  }
  
Div|= element luatexko:Horizontal {
  pdf2-attributes,
  attribute rolemaps-to {"Div"},
  (semantic-para|P)*
}

## mithesis
Div |= element mitthesis:Author{
  showtags-attributes,
  attribute rolemaps-to {"Div"},
  attribute id {text}?,
  attribute title {text}?,
  semantic-para*
  }
Div |= element mitthesis:Degree{
  showtags-attributes,
  attribute rolemaps-to {"Div"},
  attribute id {text}?,
  attribute title {text}?,
  semantic-para*
  }
Div |= element mitthesis:Copyright{
  showtags-attributes,
  attribute rolemaps-to {"Div"},
  attribute id {text}?,
  attribute title {text}?,
  semantic-para*
  }

Div |= element mitthesis:Title_sig_block{
  showtags-attributes,
  attribute rolemaps-to {"Div"},
  attribute id {text}?,
  attribute title {text}?,
  semantic-para*
  }
Div |= element mitthesis:Nomenclature_list{
  showtags-attributes,
  attribute rolemaps-to {"Div"},
  attribute id {text}?,
  attribute title {text}?,
  semantic-para*
  }
Div |= element mitthesis:Abstract_title{
  showtags-attributes,
  attribute rolemaps-to {"Div"},
  attribute id {text}?,
  attribute title {text}?,
  semantic-para*
  }
Div |= element mitthesis:Abstract_text{
  showtags-attributes,
  attribute rolemaps-to {"Div"},
  attribute id {text}?,
  attribute title {text}?,
  semantic-para*
  }
Div |= element mitthesis:Abstract_supervisor{
  showtags-attributes,
  attribute rolemaps-to {"Div"},
  attribute id {text}?,
  attribute title {text}?,
  semantic-para*
  }
Sect |= element mitthesis:Abstract_page{
  showtags-attributes,
  attribute rolemaps-to {"Sect"},
  attribute id {text}?,
  attribute title {text}?,
  (Div|semantic-para)*
  }
Span |= element mitthesis:Nomenclature_entry_heading{
  showtags-attributes,
  attribute rolemaps-to {"Span"},
  attribute id {text}?,
  attribute title {text}?,
  (ltxem|ltxspan)*
  }

# local test

text-block |= element test:authornotes {
 attribute rolemaps-to {"Part"},
 pdf2-attributes,
 authornote*
}
authornote = element test:authornote {
 attribute rolemaps-to {"FENote"},
 pdf2-attributes,
 authornotelabel?,ltxdiv
}


authornotelabel = element test:authornotelabel {
 attribute rolemaps-to {"Lbl"},
 pdf2-attributes,
 (latex.inline.content)*
}
