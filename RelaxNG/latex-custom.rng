<?xml version="1.0" encoding="UTF-8"?>
<!-- LaTeX PDF 2.0 Namespace Schema extensions v1.7b -->
<grammar xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0" xmlns:latexSEamse="https://www.latex-project.org/ns/local/asmeconf" xmlns:luatexko="https://www.latex-project.org/ns/local/luatexko" xmlns:latexSEamsej="https://www.latex-project.org/ns/local/asmejour" xmlns:pdf2="http://iso.org/pdf2/ssn" xmlns:mitthesis="https://www.latex-project.org/ns/local/mitthesis" xmlns:latexSEplay="https://www.latex-project.org/ns/local/plays" xmlns="http://relaxng.org/ns/structure/1.0">
  <include href="latex-namespace.rng"/>
  <!-- asmeconf -->
  <!--
       \tagpdfsetup { role/new-tag = { Conference_information/Div       } }
       \tagpdfsetup { role/new-tag = { Paper_number/Div                 } }
       \tagpdfsetup { role/new-tag = { Author_affiliation/Div           } }
       \tagpdfsetup { role/new-tag = { Authors/Div                      } }
       \tagpdfsetup { role/new-tag = { Affiliations-group/Div           } }
       \tagpdfsetup { role/new-tag = { Affiliation/Part                 } }
    
       \tagpdfsetup { role/new-tag = { Nomenclature_list/Div            } }
       \tagpdfsetup { role/new-tag = { Nomenclature_entry_heading/Span  } }
       
       \tagpdfsetup { role/new-tag = { Wrapper/P } } % for coffin tagging
  -->
  <define name="latex.document.content" combine="choice">
    <ref name="Conference_information"/>
    <zeroOrMore>
      <ref name="semantic-para"/>
    </zeroOrMore>
    <zeroOrMore>
      <ref name="ltxtitle"/>
    </zeroOrMore>
    <zeroOrMore>
      <ref name="Authors"/>
    </zeroOrMore>
    <zeroOrMore>
      <ref name="Affiliations-group"/>
    </zeroOrMore>
    <zeroOrMore>
      <ref name="footnote"/>
    </zeroOrMore>
    <zeroOrMore>
      <ref name="section"/>
    </zeroOrMore>
    <zeroOrMore>
      <choice>
        <ref name="figures"/>
        <ref name="tables"/>
      </choice>
    </zeroOrMore>
  </define>
  <define name="ltxtitle">
    <element name="pdf2:Title">
      <ref name="pdf1rolemap-P"/>
      <ref name="pdf2-attributes"/>
      <zeroOrMore>
        <choice>
          <text/>
          <ref name="text-fragment"/>
          <ref name="semantic-para"/>
        </choice>
      </zeroOrMore>
    </element>
  </define>
  <define name="Conference_information">
    <element name="latexSEamse:Conference_information">
      <ref name="showtags-attributes"/>
      <attribute name="rolemaps-to">
        <value>Div</value>
      </attribute>
      <optional>
        <attribute name="id"/>
      </optional>
      <zeroOrMore>
        <ref name="semantic-para"/>
      </zeroOrMore>
    </element>
  </define>
  <define name="Div" combine="choice">
    <element name="latexSEamse:Author_affiliation">
      <ref name="showtags-attributes"/>
      <attribute name="rolemaps-to">
        <value>Div</value>
      </attribute>
      <optional>
        <attribute name="id"/>
      </optional>
      <zeroOrMore>
        <ref name="semantic-para"/>
      </zeroOrMore>
    </element>
  </define>
  <define name="Affiliations-group">
    <element name="latexSEamse:Affiliations-group">
      <ref name="showtags-attributes"/>
      <attribute name="rolemaps-to">
        <value>Div</value>
      </attribute>
      <optional>
        <attribute name="id"/>
      </optional>
      <zeroOrMore>
        <ref name="semantic-para"/>
      </zeroOrMore>
    </element>
  </define>
  <define name="Div" combine="choice">
    <element name="latexSEamse:Affiliation">
      <ref name="showtags-attributes"/>
      <attribute name="rolemaps-to">
        <value>Div</value>
      </attribute>
      <optional>
        <attribute name="id"/>
      </optional>
      <zeroOrMore>
        <ref name="semantic-para"/>
      </zeroOrMore>
    </element>
  </define>
  <define name="Authors">
    <element name="latexSEamse:Authors">
      <ref name="showtags-attributes"/>
      <attribute name="rolemaps-to">
        <value>Div</value>
      </attribute>
      <optional>
        <attribute name="id"/>
      </optional>
      <optional>
        <attribute name="title"/>
      </optional>
      <zeroOrMore>
        <ref name="semantic-para"/>
      </zeroOrMore>
    </element>
  </define>
  <define name="semantic-para" combine="choice">
    <element name="latexSEamse:Paper_number">
      <ref name="showtags-attributes"/>
      <attribute name="rolemaps-to">
        <value>Div</value>
      </attribute>
      <optional>
        <attribute name="id"/>
      </optional>
      <optional>
        <attribute name="title"/>
      </optional>
      <zeroOrMore>
        <ref name="semantic-para"/>
      </zeroOrMore>
    </element>
  </define>
  <define name="Sect.content" combine="choice">
    <element name="latexSEamse:Nomenclature_list">
      <ref name="showtags-attributes"/>
      <attribute name="rolemaps-to">
        <value>Div</value>
      </attribute>
      <optional>
        <attribute name="id"/>
      </optional>
      <zeroOrMore>
        <ref name="semantic-para"/>
      </zeroOrMore>
    </element>
  </define>
  <define name="text-fragment" combine="choice">
    <element name="latexSEamse:Nomenclature_entry_heading">
      <ref name="showtags-attributes"/>
      <attribute name="rolemaps-to">
        <value>Span</value>
      </attribute>
      <optional>
        <attribute name="id"/>
      </optional>
      <zeroOrMore>
        <ref name="latex.inline.content"/>
      </zeroOrMore>
    </element>
  </define>
  <!-- luatexko -->
  <define name="Span" combine="choice">
    <element name="luatexko:StrikeOut">
      <ref name="pdf2-attributes"/>
      <attribute name="rolemaps-to">
        <value>Span</value>
      </attribute>
      <zeroOrMore>
        <choice>
          <text/>
          <ref name="Span"/>
        </choice>
      </zeroOrMore>
    </element>
  </define>
  <define name="Div" combine="choice">
    <element name="luatexko:Vertical">
      <ref name="pdf2-attributes"/>
      <attribute name="rolemaps-to">
        <value>Div</value>
      </attribute>
      <zeroOrMore>
        <choice>
          <ref name="semantic-para"/>
          <ref name="P"/>
        </choice>
      </zeroOrMore>
    </element>
  </define>
  <define name="Div" combine="choice">
    <element name="luatexko:Horizontal">
      <ref name="pdf2-attributes"/>
      <attribute name="rolemaps-to">
        <value>Div</value>
      </attribute>
      <zeroOrMore>
        <choice>
          <ref name="semantic-para"/>
          <ref name="P"/>
        </choice>
      </zeroOrMore>
    </element>
  </define>
  <define name="Div" combine="choice">
    <a:documentation>mithesis</a:documentation>
    <element name="mitthesis:Author">
      <ref name="showtags-attributes"/>
      <attribute name="rolemaps-to">
        <value>Div</value>
      </attribute>
      <optional>
        <attribute name="id"/>
      </optional>
      <optional>
        <attribute name="title"/>
      </optional>
      <zeroOrMore>
        <ref name="semantic-para"/>
      </zeroOrMore>
    </element>
  </define>
  <define name="Div" combine="choice">
    <element name="mitthesis:Degree">
      <ref name="showtags-attributes"/>
      <attribute name="rolemaps-to">
        <value>Div</value>
      </attribute>
      <optional>
        <attribute name="id"/>
      </optional>
      <optional>
        <attribute name="title"/>
      </optional>
      <zeroOrMore>
        <ref name="semantic-para"/>
      </zeroOrMore>
    </element>
  </define>
  <define name="Div" combine="choice">
    <element name="mitthesis:Copyright">
      <ref name="showtags-attributes"/>
      <attribute name="rolemaps-to">
        <value>Div</value>
      </attribute>
      <optional>
        <attribute name="id"/>
      </optional>
      <optional>
        <attribute name="title"/>
      </optional>
      <zeroOrMore>
        <ref name="semantic-para"/>
      </zeroOrMore>
    </element>
  </define>
  <define name="Div" combine="choice">
    <element name="mitthesis:Title_sig_block">
      <ref name="showtags-attributes"/>
      <attribute name="rolemaps-to">
        <value>Div</value>
      </attribute>
      <optional>
        <attribute name="id"/>
      </optional>
      <optional>
        <attribute name="title"/>
      </optional>
      <zeroOrMore>
        <ref name="semantic-para"/>
      </zeroOrMore>
    </element>
  </define>
  <define name="Div" combine="choice">
    <element name="mitthesis:Nomenclature_list">
      <ref name="showtags-attributes"/>
      <attribute name="rolemaps-to">
        <value>Div</value>
      </attribute>
      <optional>
        <attribute name="id"/>
      </optional>
      <optional>
        <attribute name="title"/>
      </optional>
      <zeroOrMore>
        <ref name="semantic-para"/>
      </zeroOrMore>
    </element>
  </define>
  <define name="Div" combine="choice">
    <element name="mitthesis:Abstract_title">
      <ref name="showtags-attributes"/>
      <attribute name="rolemaps-to">
        <value>Div</value>
      </attribute>
      <optional>
        <attribute name="id"/>
      </optional>
      <optional>
        <attribute name="title"/>
      </optional>
      <zeroOrMore>
        <ref name="semantic-para"/>
      </zeroOrMore>
    </element>
  </define>
  <define name="Div" combine="choice">
    <element name="mitthesis:Abstract_text">
      <ref name="showtags-attributes"/>
      <attribute name="rolemaps-to">
        <value>Div</value>
      </attribute>
      <optional>
        <attribute name="id"/>
      </optional>
      <optional>
        <attribute name="title"/>
      </optional>
      <zeroOrMore>
        <ref name="semantic-para"/>
      </zeroOrMore>
    </element>
  </define>
  <define name="Div" combine="choice">
    <element name="mitthesis:Abstract_supervisor">
      <ref name="showtags-attributes"/>
      <attribute name="rolemaps-to">
        <value>Div</value>
      </attribute>
      <optional>
        <attribute name="id"/>
      </optional>
      <optional>
        <attribute name="title"/>
      </optional>
      <zeroOrMore>
        <ref name="semantic-para"/>
      </zeroOrMore>
    </element>
  </define>
  <define name="Sect" combine="choice">
    <element name="mitthesis:Abstract_page">
      <ref name="showtags-attributes"/>
      <attribute name="rolemaps-to">
        <value>Sect</value>
      </attribute>
      <optional>
        <attribute name="id"/>
      </optional>
      <optional>
        <attribute name="title"/>
      </optional>
      <zeroOrMore>
        <choice>
          <ref name="Div"/>
          <ref name="semantic-para"/>
        </choice>
      </zeroOrMore>
    </element>
  </define>
  <define name="Span" combine="choice">
    <element name="mitthesis:Nomenclature_entry_heading">
      <ref name="showtags-attributes"/>
      <attribute name="rolemaps-to">
        <value>Span</value>
      </attribute>
      <optional>
        <attribute name="id"/>
      </optional>
      <optional>
        <attribute name="title"/>
      </optional>
      <zeroOrMore>
        <choice>
          <ref name="ltxem"/>
          <ref name="ltxspan"/>
        </choice>
      </zeroOrMore>
    </element>
  </define>
</grammar>
