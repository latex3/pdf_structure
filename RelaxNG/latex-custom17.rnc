# LaTeX PDF 1.7 Namespace Schema extensions v1.7c

namespace pdf2 = ""
namespace asmeconf = ""
namespace luatexko = ""
namespace asmeconfj = ""
namespace mitthesis = ""

include "latex-namespace17.rnc"


# asmeconf

#    \tagpdfsetup { role/new-tag = { Conference_information/Div       } }
#    \tagpdfsetup { role/new-tag = { Paper_number/Div                 } }
#    \tagpdfsetup { role/new-tag = { Author_affiliation/Div           } }
#    \tagpdfsetup { role/new-tag = { Authors/Div                      } }
#    \tagpdfsetup { role/new-tag = { Affiliations-group/Div           } }
#    \tagpdfsetup { role/new-tag = { Affiliation/Part                 } }
#
#    \tagpdfsetup { role/new-tag = { Nomenclature_list/Div            } }
#    \tagpdfsetup { role/new-tag = { Nomenclature_entry_heading/Span  } }
#    
#    \tagpdfsetup { role/new-tag = { Wrapper/P } } % for coffin tagging


latex.document.content |=
(Conference_information,semantic-para*,ltxtitle*,Authors*,Affiliations-group*,
footnote*,section*,(figures|tables)*)


Conference_information =element asmeconf:Conference_information {
  showtags-attributes,
  attribute rolemaps-to {"Div"},
  attribute id {text}?,
  semantic-para*
}



Div |= element asmeconf:Author_affiliation {
  showtags-attributes,
  attribute rolemaps-to {"Div"},
  attribute id {text}?,
  semantic-para*
  }

Affiliations-group = element asmeconf:Affiliations-group {
  showtags-attributes,
  attribute rolemaps-to {"Div"},
  attribute id {text}?,
  semantic-para*
  }

Div|= element asmeconf:Affiliation {
  showtags-attributes,
  attribute rolemaps-to {"Div"},
  attribute id {text}?,
  semantic-para*
  }

Authors = element asmeconf:Authors {
  showtags-attributes,
  attribute rolemaps-to {"Div"},
  attribute id {text}?,
  attribute title {text}?,
  semantic-para*
  }


semantic-para |= element asmeconf:Paper_number {
  showtags-attributes,
  attribute rolemaps-to {"Div"},
  attribute id {text}?,
  attribute title {text}?,
  semantic-para*
  }


Sect.content |= element asmeconf:Nomenclature_list {
  showtags-attributes,
  attribute rolemaps-to {"Div"},
  attribute id {text}?,
  semantic-para*
  }

text-fragment |= element asmeconf:Nomenclature_entry_heading {
  showtags-attributes,
  attribute rolemaps-to {"Span"},
  attribute id {text}?,
  (latex.inline.content)*
  }
