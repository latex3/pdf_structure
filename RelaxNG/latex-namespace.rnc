namespace NoNS = ""
namespace latexSE = "https://www.latex-project.org/ns/dflt"
namespace pdf1 = "http://iso.org/pdf/ssn"
namespace pdf2 = "http://iso.org/pdf2/ssn"
namespace mml = "http://www.w3.org/1998/Math/MathML"
namespace Layout = "http://iso.org/pdf/ssn/Layout"
namespace Table = "http://iso.org/pdf/ssn/Table"

include "document-pdf-ua2.rnc" {

Document = element pdf2:Document {
pdf2-attributes,
(Artifact*
&
(
(title-block? & ((section1|semantic-para|ltxsect|theorem-like|table|footnote|link|float|aside|Figure)*,chapter1*,part*,(figures? & tables?)))
|
(title1-block? & ((section2|semantic-para|ltxsect|theorem-like|table|footnote|link|float|aside|Figure)*,chapter2*,part*,(figures? & tables?)))
)
)
}

Sect.content = (semantic-para|theorem-like|footnote|toc|table)

Caption = element pdf2:Caption {
 pdf2-attributes,
 (
 Lbl? & (text|text-fragment|text-block|reference|link)*
 )
}

sechead.content =
  pdf2-attributes,
  (heading-fragment|heading-parbox|text|text-fragment|ltxspan|footnotemark|formula|link)*
  

## end of over-ride of ua2 schema
}

## section heirarchy

title-block = element latexSE:title-block {
  attribute rolemaps-to {"Div"},
   pdf2-attributes,
   (title-text & (title-author|title-date)*)
 }
title1-block = element latexSE:title-block {
  attribute rolemaps-to {"Div"},
   pdf2-attributes,
   (title1-text & (title-author|title-date)*)
 }

title-text = element latexSE:title-text {
  attribute rolemaps-to {"Title"},
   pdf2-attributes,
   (sechead.content)
 }

title1-text = element latexSE:title-text {
  attribute rolemaps-to {"Title"},
   pdf2-attributes,
   (sechead.content)
 }


# title = element latexSE:title      {attribute rolemaps-to {"Title"}, sechead.content}

title-author = element latexSE:title-author {
  attribute rolemaps-to {"P"},
   pdf2-attributes,
   (text|text-fragment|link|footnotemark)*
 }
title-date = element latexSE:title-date {
  attribute rolemaps-to {"P"},
   pdf2-attributes,
   (text|text-fragment|footnotemark)
 }

part = element latexSE:part                  {pdf2-attributes,attribute rolemaps-to {"Part"}, part-heading,(chapter1|chapter2|section|Sect.content)*}

part-heading = element latexSE:part-heading          {pdf2-attributes, attribute rolemaps-to {"Title"}, (heading-number? & sechead.content)}

chapter1 = element latexSE:chapter   {
  pdf2-attributes,
  attribute rolemaps-to {"Sect"},
  chapter-heading1,Sect.content*,section*
  }

chapter-heading1 = element latexSE:chapter-heading       {pdf2-attributes, attribute rolemaps-to {"H1"}, (heading-number?  & sechead.content)}

chapter2= element latexSE:chapter   {
  pdf2-attributes,
  attribute rolemaps-to {"Sect"},
  chapter-heading2,Sect.content*,section*
  }

chapter-heading2 = element latexSE:chapter-heading       {pdf2-attributes, attribute rolemaps-to {"H2"}, (heading-number? & sechead.content)}

section1 = element latexSE:section   {
  pdf2-attributes,
  attribute rolemaps-to {"Sect"},
  section-heading1,Sect.content*,subsection*
  }

section-heading1 = element latexSE:section-heading       {pdf2-attributes, attribute rolemaps-to {"H1"}, (heading-number? & sechead.content)}

section2 = element latexSE:section   {
  pdf2-attributes,
  attribute rolemaps-to {"Sect"},
  section-heading2,Sect.content*,subsection*
  }

section-heading2 = element latexSE:section-heading       {pdf2-attributes, attribute rolemaps-to {"H2"}, (heading-number? & sechead.content)}

section = element latexSE:section   {
  pdf2-attributes,
  attribute rolemaps-to {"Sect"},
  section-heading,Sect.content*,subsection*
  }

section-heading = element latexSE:section-heading       {pdf2-attributes, attribute rolemaps-to {"H1"|"H2"|"H3"}, (heading-number? & sechead.content)}

subsection = element latexSE:subsection   {
  pdf2-attributes,
  attribute rolemaps-to {"Sect"},
  subsection-heading,Sect.content*,subsubsection*
  }

subsection-heading = element latexSE:subsection-heading       {pdf2-attributes, attribute rolemaps-to {"H2"|"H3"|"H4"}, (heading-number? & sechead.content)}


subsubsection = element latexSE:subsubsection   {
  pdf2-attributes,
  attribute rolemaps-to {"Sect"},
  subsubsection-heading,Sect.content*,paragraph*
  }

subsubsection-heading = element latexSE:subsubsection-heading       {pdf2-attributes, attribute rolemaps-to {"H3"|"H4"|"H5"}, (heading-number? & sechead.content)}

paragraph = element latexSE:paragraph   {
  pdf2-attributes,
  attribute rolemaps-to {"Sect"},
  paragraph-heading,Sect.content*,subparagraph*
  }

paragraph-heading = element latexSE:paragraph-heading       {pdf2-attributes, attribute rolemaps-to {"H4"|"H5"|"H6"}, (heading-number? & sechead.content)}

subparagraph = element latexSE:subparagraph   {
  pdf2-attributes,
  attribute rolemaps-to {"Sect"},
  subparagraph-heading,Sect.content*
  }

subparagraph-heading = element latexSE:subparagraph-heading       {pdf2-attributes, attribute rolemaps-to {"H5"|"H6"|"H7"}, (heading-number? & sechead.content) }

heading-number = element latexSE:heading-number {
  attribute rolemaps-to {"Lbl"|"Span"},			
  pdf2-attributes,
  (text|mathse)*
}

heading-fragment = element latexSE:heading-fragment {
  attribute rolemaps-to {"Span"},
pdf2-attributes,
(heading-number? & (text|text-fragment)*)
}

heading-parbox = element (latexSE:heading-parbox|latexSE:heading-minipage) {
  attribute rolemaps-to {"Span"},
pdf2-attributes,
(text|text-fragment|heading-fragment)*
}

## end of headings

## paragraphs

semantic-para = element latexSE:semantic-para {
  attribute rolemaps-to {"Part"},
  pdf2-attributes,
   title-text?,Caption?,(text-block|text-minipage|quotation|enumerate|itemize|description|\list|verbatim|quote|formula|table|aside)*}

text-block = element latexSE:text-block {
 attribute rolemaps-to {"P"},
 pdf2-attributes,
 (Lbl*
 &
 (text|
 text-fragment|ltxem|ltxstrong|ltxspan|footnotemark|footnote|ruby|warichu|link|formula|reference|code|
 Figure|Form|Annot)*
 )
}

text-fragment = element latexSE:text-fragment {
attribute rolemaps-to {"Span"},
pdf2-attributes,
(text|
code|Sub|Lbl|ltxem|ltxstrong|ltxspan|link|reference|Annot|Form|ruby|warichu|FENote|BibEntry|Figure|formula|Artifact)*
}

## Floats

figures = element latexSE:figures {
  attribute rolemaps-to {"Sect"},
  attribute id {text}?,
  showtags-attributes,
  float*
 }

tables = element latexSE:tables {
  attribute rolemaps-to {"Sect"},
  attribute id {text}?,
  showtags-attributes,
  float*
 }

float = element latexSE:float {
  attribute rolemaps-to {"Aside"|"Note"},
  attribute id {text}?,
  showtags-attributes,
  (text|Caption|semantic-para|Figure|text-fragment|formula)*
 }


## blocks

verbatim = element latexSE:verbatim {
  attribute rolemaps-to {"P"|"Code"},
  pdf2-attributes,
  (Caption? & (codeline)*)
}


codeline = element latexSE:codeline {
  attribute rolemaps-to {"Sub"|"Span"},
  pdf2-attributes,
  (text|ltxem|ltxstrong|ltxspan|formula|Lbl)*
}




\list = element latexSE:list {
 attribute rolemaps-to {"L"},
  pdf2-attributes,
  list-attributes,
  (item|ltxli)*
}

itemize = element latexSE:itemize {
  attribute rolemaps-to {"L"},
  pdf2-attributes,
  list-attributes,
  item*
}


enumerate = element latexSE:enumerate {
  attribute rolemaps-to {"L"},
  pdf2-attributes,
  list-attributes,
  item*
}


quote = element latexSE:quote {
 attribute rolemaps-to {"BlockQuote"},
 pdf2-attributes,
 (semantic-para)*
}

quotation = element latexSE:quotation {
 attribute rolemaps-to {"BlockQuote"},
 pdf2-attributes,
 (text|semantic-para)*
}

description= element latexSE:description {
 attribute rolemaps-to {"L"},
 pdf2-attributes,
 list-attributes,
 item*
}


item = element latexSE:item {
  pdf2-attributes,
  attribute rolemaps-to {"LI"},
  (itemlabel?,itembody?)
}

ltxli = element pdf2:LI {
  pdf2-attributes,
  (Lbl?,ltxlbody?)
}

itemlabel = element latexSE:itemlabel {
  pdf2-attributes,
  attribute rolemaps-to {"Lbl"},
  (text|text-fragment|semantic-para|ltxem|ltxstrong|ltxspan|formula|link)*
}

itembody = element latexSE:itembody {
  pdf2-attributes,
  attribute rolemaps-to {"LBody"},
  ((text|text-block|semantic-para)*)
  }

ltxlbody = element pdf2:LBody {
  pdf2-attributes,
  ((text|text-block|semantic-para)*)
  }

theorem-like = element latexSE:theorem-like {
  attribute rolemaps-to {"Sect"},
  attribute id {text}?,
  showtags-attributes,
  Caption?,
  Lbl?,
  (semantic-para)*
}

text-minipage =  element (latexSE:text-minipage|latexSE:text-parbox) {
  attribute rolemaps-to {"Div"},
  pdf2-attributes,
(text|semantic-para|formula)*
}


footnotemark = element latexSE:footnotemark {
 attribute rolemaps-to {"Lbl"},
 pdf2-attributes,
(text|text-fragment|link)*
}

footnote = element latexSE:footnote {
  attribute rolemaps-to {"FENote"|"Note"},
  pdf2-attributes,
  footnotelabel,(text|semantic-para)*
}

footnotelabel = element latexSE:footnotelabel {
 attribute rolemaps-to {"Lbl"},
 pdf2-attributes,
 (text|text-fragment)*
}

## still using pdf elements, redeclared here to constrain children back to latex-namespace

link = element pdf2:Link {
 pdf2-attributes,
 (
 (text|Lbl|text-fragment|formula)*
 |
 (Lbl|text-fragment|semantic-para|formula)*
 )
 }

reference = element pdf1:Reference {
pdf2-attributes,
(text|Lbl|text-fragment|link)*
   }

toc = element pdf1:TOC {
 pdf2-attributes,
 (toc|toci)*
 }

toci = element pdf1:TOCI {
 pdf2-attributes,
 (Lbl|reference)*
 }

code = element pdf1:Code {
pdf2-attributes,
(text)*
}
# should be text-fragment?
ltxspan = element pdf2:Span {pdf2-attributes,
(text|text-fragment)*
}
ltxdiv = element pdf2:Div {pdf2-attributes,
(text-block)*
}
ltxem = element pdf2:Em {pdf2-attributes,
(text|text-fragment)*
}
ltxstrong = element pdf2:Strong {pdf2-attributes,
(text|text-fragment)*
}


### formula
# expanded pdf2-attributes to avoid so much backtracking
formula = element pdf2:Formula {
    AssociatedFiletext*,
    formula-requirements ,
    AssociatedFiletext*,
  (
  attribute lang {text}?,              # Lang
  attribute expansion {text}?,         # E
  attribute title {text}?,             # T
  attribute id {text}?,                # ID
  attribute phoneme {text}?,           # Phoneme
  attribute phonetic-alphabet {text}?, # PhoneticAlphabet
  attribute revision {text}?,          # R
  layout-attributes,
  otherns-attributes,
  attribute af {text}?,
  attribute rolemapped-from {text}?,
  attribute referenced-as {text}?,
  attribute Layout:Width {text}?,
  attribute Layout:Height {text}?,
(Lbl|semantic-para|link|mathse|text|Figure)*
)
}


table = element pdf2:Table {
  pdf2-attributes,
  attribute Layout:Width {text}?,
  attribute Layout:Height {text}?,
  table-attributes,
((tr)* & (THead?,TBody*,TFoot?) & Caption? & Artifact*)
 }

tr = element pdf2:TR {
  pdf2-attributes,
  table-attributes,
 (th|td)*
 }

th = element pdf2:TH {
  pdf2-attributes,
  attribute Layout:Width {text}?,
  attribute Layout:Height {text}?,
  attribute Layout:BlockAlign {"Before" | "Middle" | "After" | "Justify"}?,
  attribute Layout:InlineAlign {"Start" | "Center" | "End"}?,
  attribute Layout:TBorderStyle {text}?,
  attribute Layout:TPadding {text}?,
#
  table-attributes,
  attribute Table:Scope {"Column" | "Row" | "Both"}?,
  attribute Table:Short {text}?,
 (text|text-fragment|footnotemark|text-block|verbatim|formula|table|ltxdiv)*
 }

td = element pdf2:TD {
  pdf2-attributes,
  attribute Layout:Width {text}?,
  attribute Layout:Height {text}?,
  attribute Layout:BlockAlign {"Before" | "Middle" | "After" | "Justify"}?,
  attribute Layout:InlineAlign {"Start" | "Center" | "End"}?,
  attribute Layout:TBorderStyle {text}?,
  attribute Layout:TPadding {text}?,
#
  table-attributes,
 (text|text-fragment|footnotemark|verbatim|text-block|formula|table|ltxdiv)*
 }


aside = element pdf2:Aside {
  pdf1rolemap-Any,
  pdf2-attributes,
  (semantic-para)*
  }


ruby = element pdf2:Ruby {
  pdf2-attributes,
  attribute Layout:RubyAlign {"Start" | "Center" | "End" | "Justify" | "Distribute"}?,
  attribute Layout:RubyPosition {"Before" | "After" | "Warichu" | "Inline"}?,
( (text)* & 	(rb,(rt|(rb,rt,rp))) )
}

rb = element pdf2:RB {
  pdf2-attributes,
  attribute Layout:RubyAlign {"Start" | "Center" | "End" | "Justify" | "Distribute"}?,
  attribute Layout:RubyPosition {"Before" | "After" | "Warichu" | "Inline"}?,
(text|text-fragment)*
}

rt = element pdf2:RT {
  pdf2-attributes,
  attribute Layout:RubyAlign {"Start" | "Center" | "End" | "Justify" | "Distribute"}?,
  attribute Layout:RubyPosition {text}?,
(text|text-fragment)*
}

rp = element pdf2:RP {
  pdf2-attributes,
  attribute Layout:RubyAlign {text}?,
  attribute Layout:RubyPosition {text}?,
(text|text-fragment)*
}

warichu = element pdf2:Warichu {
pdf2-attributes,
((text)*  & (wp,wt,wp) )
}

wt = element pdf2:WT {
pdf2-attributes,
(text|text-fragment)*
}

wp = element pdf2:WP {
pdf2-attributes,
(text|text-fragment)*
}


ltxsect = element pdf2:Sect {
pdf2-attributes,
(Caption? & (text|text-fragment|text-block|semantic-para)*)
}
