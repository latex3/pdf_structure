# LaTeX PDF 1.7 Shakespeare Play Schema v1.7c

namespace latexSEplay = ""
include "latex-namespace17.rnc"
ltxspan |= element latexSEplay:SceneDescription {pdf2-attributes,attribute rolemaps-to {"Span"}, text}
ltxstrong |= element latexSEplay:Speaker {pdf2-attributes,attribute rolemaps-to {"Strong"},text}
