<?xml version="1.0" encoding="UTF-8"?>
<!-- LaTeX PDF 1.7 Shakespeare Play Schema v1.7c -->
<grammar xmlns="http://relaxng.org/ns/structure/1.0">
  <include href="latex-namespace17.rng"/>
  <define name="ltxspan" combine="choice">
    <element>
      <name ns="">SceneDescription</name>
      <ref name="pdf2-attributes"/>
      <attribute name="rolemaps-to">
        <value>Span</value>
      </attribute>
      <text/>
    </element>
  </define>
  <define name="ltxstrong" combine="choice">
    <element>
      <name ns="">Speaker</name>
      <ref name="pdf2-attributes"/>
      <attribute name="rolemaps-to">
        <value>Span</value>
      </attribute>
      <text/>
    </element>
  </define>
</grammar>
