# LaTeX ltx-talk Namespace Schema v1.7c

namespace latexSEtalk = "https://www.latex-project.org/ns/local/ltx-talk"

## PDF/UA-2

include "latex-namespace.rnc"

# LaTeX Talk Markup Namespace

  
latex.document.content |= frame*

frame = element latexSEtalk:frame {
  pdf2-attributes,
  attribute rolemaps-to {"Sect"},
  frametitle?,(semantic-para|Aside)*,slide*}*



frametitle = element latexSEtalk:frametitle {
  pdf2-attributes,
  attribute rolemaps-to {"H1"|"H4"},
  (text|text-fragment|Formula|Span)*
}

slide = element latexSEtalk:slide {
  pdf2-attributes,
  attribute rolemaps-to {"Div"},
  (text|text-fragment|semantic-para|Aside)*
}

