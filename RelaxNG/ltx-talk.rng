<?xml version="1.0" encoding="UTF-8"?>
<!-- LaTeX ltx-talk Namespace Schema v1.7c -->
<grammar xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0" xmlns:latexSEtalk="https://www.latex-project.org/ns/local/ltx-talk" xmlns="http://relaxng.org/ns/structure/1.0">
  <include href="latex-namespace.rng">
    <a:documentation>PDF/UA-2</a:documentation>
  </include>
  <!-- LaTeX Talk Markup Namespace -->
  <define name="latex.document.content" combine="interleave">
    <zeroOrMore>
      <ref name="frame"/>
    </zeroOrMore>
  </define>
  <define name="frame">
    <element name="latexSEtalk:frame">
      <ref name="pdf2-attributes"/>
      <attribute name="rolemaps-to">
        <value>Sect</value>
      </attribute>
      <optional>
        <ref name="frametitle"/>
      </optional>
      <zeroOrMore>
        <choice>
          <ref name="semantic-para"/>
          <ref name="Aside"/>
        </choice>
      </zeroOrMore>
    </element>
  </define>
  <define name="frametitle">
    <element name="latexSEtalk:frametitle">
      <ref name="pdf2-attributes"/>
      <attribute name="rolemaps-to">
        <choice>
          <value>H1</value>
          <value>H4</value>
        </choice>
      </attribute>
      <zeroOrMore>
        <ref name="latex.inline.content"/>
      </zeroOrMore>
    </element>
  </define>
</grammar>
